# Copy to .env and edit. Never commit .env. (Comments must be on their own lines.)

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=instance/navora.db
# Set COOKIE_SECURE=1 when served over HTTPS
COOKIE_SECURE=0
# Used in sitemap.xml / robots.txt
SITE_URL=http://localhost:5000
ADMIN_EMAIL=admin@navora.local
# Leave ADMIN_PASSWORD empty to have the seed script generate a random one
ADMIN_PASSWORD=

# Optional external LLM for the AI Mentor (the app works fully without these)
LLM_API_KEY=
LLM_MODEL=
